{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hr.dev/verdict/v1",
  "title": "VERDICT",
  "description": "QA. Evidence and risk, never a merge decision - Release decides. The subject is the CHANGE this grades.",
  "type": "object",
  "required": ["acceptance", "blastRadius", "risks"],
  "additionalProperties": false,
  "properties": {
    "specId": { "type": "string", "description": "Absent means the change served a finding, not a spec." },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "state"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "state": { "enum": ["met", "unmet", "unverifiable"] },
          "evidence": { "type": "string", "description": "The test that went red-to-green, the request and response. A finding without evidence is not a finding." }
        }
      }
    },
    "blastRadius": {
      "type": "object",
      "required": ["covered", "uncovered", "failed"],
      "additionalProperties": false,
      "properties": {
        "covered": { "type": "array", "items": { "type": "object", "required": ["path", "gates"], "properties": { "path": { "type": "string" }, "gates": { "type": "array", "items": { "type": "string" } } } } },
        "uncovered": { "type": "array", "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" }, "watchedInProd": { "type": "boolean" } } } },
        "failed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bands": {
      "type": "object",
      "description": "Confidence per depth. A clean answer that omits bands 2 and 3 reads as checked when it is not.",
      "additionalProperties": { "type": "object", "properties": { "confidence": { "enum": ["certain", "likely", "unknown"] }, "status": { "type": "string" } } }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "why", "confidence"],
        "additionalProperties": false,
        "properties": {
          "what": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["certain", "likely", "unknown"] }
        }
      }
    }
  }
}
