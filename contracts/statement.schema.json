{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hr/statement/v1",
  "title": "in-toto Statement v1",
  "description": "The envelope every hr artifact travels in. Field names and semantics are in-toto's, not ours; the predicate is entirely ours. See ../contracts/README.md.",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "additionalProperties": false,
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": {
            "type": "object",
            "minProperties": 1,
            "description": "Algorithm to lowercase hex. A subject is matched purely by digest - never by name, never by a mutable ref.",
            "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]+$" }
          }
        }
      }
    },
    "predicateType": { "type": "string", "pattern": "^https://hr\\.dev/[a-z]+/v[0-9]+$" },
    "predicate": { "type": "object" }
  }
}
